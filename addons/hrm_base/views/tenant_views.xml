<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hrm_tenant_tree" model="ir.ui.view">
        <field name="name">hrm.tenant.tree</field>
        <field name="model">hrm.tenant</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="slug"/><field name="status"/><field name="default_currency"/></list>
        </field>
    </record>
    <record id="view_hrm_tenant_form" model="ir.ui.view">
        <field name="name">hrm.tenant.form</field>
        <field name="model">hrm.tenant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/><field name="name"/><field name="slug"/>
                        <field name="status"/><field name="timezone"/><field name="locale"/>
                        <field name="default_currency"/><field name="country_code"/>
                    </group>
                    <group string="Technical"><field name="uuid" readonly="1"/><field name="version" readonly="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hrm_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">hrm.tenant</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
