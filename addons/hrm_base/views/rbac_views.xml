<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hrm_role_tree" model="ir.ui.view">
        <field name="name">hrm.role.tree</field>
        <field name="model">hrm.role</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="is_system"/><field name="status"/></list>
        </field>
    </record>
    <record id="view_hrm_role_form" model="ir.ui.view">
        <field name="name">hrm.role.form</field>
        <field name="model">hrm.role</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="tenant_id"/><field name="code"/><field name="name"/>
                <field name="is_system"/><field name="status"/>
                <field name="permission_ids" widget="many2many_tags"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_hrm_role" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">hrm.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_permission_tree" model="ir.ui.view">
        <field name="name">hrm.permission.tree</field>
        <field name="model">hrm.permission</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="resource"/><field name="action"/></list>
        </field>
    </record>
    <record id="action_hrm_permission" model="ir.actions.act_window">
        <field name="name">Permissions</field>
        <field name="res_model">hrm.permission</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_user_role_tree" model="ir.ui.view">
        <field name="name">hrm.user.role.tree</field>
        <field name="model">hrm.user.role</field>
        <field name="arch" type="xml">
            <list><field name="user_id"/><field name="role_id"/><field name="effective_from"/><field name="effective_to"/></list>
        </field>
    </record>
    <record id="action_hrm_user_role" model="ir.actions.act_window">
        <field name="name">User Roles</field>
        <field name="res_model">hrm.user.role</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_role_scope_tree" model="ir.ui.view">
        <field name="name">hrm.role.scope.tree</field>
        <field name="model">hrm.role.scope</field>
        <field name="arch" type="xml">
            <list><field name="role_id"/><field name="scope_type"/><field name="scope_ref"/></list>
        </field>
    </record>
    <record id="action_hrm_role_scope" model="ir.actions.act_window">
        <field name="name">Role Scopes</field>
        <field name="res_model">hrm.role.scope</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
