<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hrm_company_tree" model="ir.ui.view">
        <field name="name">hrm.company.tree</field>
        <field name="model">hrm.company</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="tenant_id"/><field name="status"/></list>
        </field>
    </record>
    <record id="view_hrm_company_form" model="ir.ui.view">
        <field name="name">hrm.company.form</field>
        <field name="model">hrm.company</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tenant_id"/><field name="code"/><field name="name"/>
                        <field name="legal_name"/><field name="registration_no"/>
                        <field name="parent_company_id"/><field name="res_company_id"/>
                        <field name="country_code"/><field name="currency_code"/>
                        <field name="timezone"/><field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hrm_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">hrm.company</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_department_tree" model="ir.ui.view">
        <field name="name">hrm.department.tree</field>
        <field name="model">hrm.department</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="company_id"/><field name="status"/><field name="effective_from"/></list>
        </field>
    </record>
    <record id="view_hrm_department_form" model="ir.ui.view">
        <field name="name">hrm.department.form</field>
        <field name="model">hrm.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="tenant_id"/><field name="company_id"/>
                        <field name="business_unit_id"/><field name="parent_id"/>
                        <field name="code"/><field name="name"/>
                        <field name="manager_user_id"/><field name="cost_center_id"/>
                        <field name="status"/>
                        <field name="effective_from"/><field name="effective_to"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_hrm_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hrm.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_business_unit_tree" model="ir.ui.view">
        <field name="name">hrm.business.unit.tree</field>
        <field name="model">hrm.business.unit</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="company_id"/><field name="status"/></list>
        </field>
    </record>
    <record id="view_hrm_business_unit_form" model="ir.ui.view">
        <field name="name">hrm.business.unit.form</field>
        <field name="model">hrm.business.unit</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="tenant_id"/><field name="company_id"/><field name="parent_id"/>
                <field name="code"/><field name="name"/><field name="manager_user_id"/><field name="status"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_hrm_business_unit" model="ir.actions.act_window">
        <field name="name">Business Units</field>
        <field name="res_model">hrm.business.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_location_tree" model="ir.ui.view">
        <field name="name">hrm.location.tree</field>
        <field name="model">hrm.location</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="location_type"/><field name="city"/><field name="status"/></list>
        </field>
    </record>
    <record id="view_hrm_location_form" model="ir.ui.view">
        <field name="name">hrm.location.form</field>
        <field name="model">hrm.location</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="tenant_id"/><field name="company_id"/><field name="parent_id"/>
                <field name="code"/><field name="name"/><field name="location_type"/>
                <field name="address_line1"/><field name="city"/><field name="country_code"/>
                <field name="timezone"/><field name="status"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_hrm_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">hrm.location</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_cost_center_tree" model="ir.ui.view">
        <field name="name">hrm.cost.center.tree</field>
        <field name="model">hrm.cost.center</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="company_id"/><field name="status"/></list>
        </field>
    </record>
    <record id="view_hrm_cost_center_form" model="ir.ui.view">
        <field name="name">hrm.cost.center.form</field>
        <field name="model">hrm.cost.center</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="tenant_id"/><field name="company_id"/><field name="parent_id"/>
                <field name="code"/><field name="name"/><field name="status"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_hrm_cost_center" model="ir.actions.act_window">
        <field name="name">Cost Centers</field>
        <field name="res_model">hrm.cost.center</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
