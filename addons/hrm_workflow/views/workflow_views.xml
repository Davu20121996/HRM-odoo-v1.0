<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hrm_wf_definition_list" model="ir.ui.view">
        <field name="name">hrm.workflow.definition.list</field>
        <field name="model">hrm.workflow.definition</field>
        <field name="arch" type="xml">
            <list><field name="code"/><field name="name"/><field name="entity_type"/><field name="version"/><field name="status"/></list>
        </field>
    </record>
    <record id="view_hrm_wf_definition_form" model="ir.ui.view">
        <field name="name">hrm.workflow.definition.form</field>
        <field name="model">hrm.workflow.definition</field>
        <field name="arch" type="xml">
            <form><sheet>
                <group>
                    <field name="tenant_id"/><field name="code"/><field name="name"/>
                    <field name="entity_type"/><field name="version"/><field name="status"/>
                </group>
                <field name="step_ids">
                    <list><field name="sequence_no"/><field name="step_code"/><field name="name"/><field name="approver_type"/></list>
                </field>
            </sheet></form>
        </field>
    </record>
    <record id="action_hrm_wf_definition" model="ir.actions.act_window">
        <field name="name">Definitions</field>
        <field name="res_model">hrm.workflow.definition</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_wf_instance_list" model="ir.ui.view">
        <field name="name">hrm.workflow.instance.list</field>
        <field name="model">hrm.workflow.instance</field>
        <field name="arch" type="xml">
            <list><field name="definition_id"/><field name="entity_type"/><field name="current_state"/><field name="status"/><field name="started_at"/></list>
        </field>
    </record>
    <record id="view_hrm_wf_instance_form" model="ir.ui.view">
        <field name="name">hrm.workflow.instance.form</field>
        <field name="model">hrm.workflow.instance</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="tenant_id"/><field name="definition_id"/>
                <field name="entity_type"/><field name="entity_id"/>
                <field name="current_state"/><field name="status"/>
                <field name="started_by_id"/><field name="completed_at"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_hrm_wf_instance" model="ir.actions.act_window">
        <field name="name">Instances</field>
        <field name="res_model">hrm.workflow.instance</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_approval_list" model="ir.ui.view">
        <field name="name">hrm.approval.request.list</field>
        <field name="model">hrm.approval.request</field>
        <field name="arch" type="xml">
            <list><field name="instance_id"/><field name="step_id"/><field name="approver_user_id"/><field name="decision"/><field name="decided_at"/></list>
        </field>
    </record>
    <record id="action_hrm_approval" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">hrm.approval.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_hrm_notification_list" model="ir.ui.view">
        <field name="name">hrm.notification.list</field>
        <field name="model">hrm.notification</field>
        <field name="arch" type="xml">
            <list><field name="recipient_user_id"/><field name="channel"/><field name="template_code"/><field name="subject"/><field name="status"/></list>
        </field>
    </record>
    <record id="action_hrm_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">hrm.notification</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
