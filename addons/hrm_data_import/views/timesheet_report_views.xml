<odoo>
<record id="access_attendance_month" model="ir.access"><field name="name">Attendance matrix read</field><field name="model_id" ref="model_hrm_attendance_month"/><field name="group_id" ref="hrm_base.group_hrm_user"/><field name="operation">r</field></record>
<record id="scope_attendance_month" model="ir.access"><field name="name">Attendance matrix company privacy</field><field name="model_id" ref="model_hrm_attendance_month"/><field name="operation">crud</field><field name="domain">[('company_id', 'in', user.hrm_company_ids.ids)]</field></record>
<record id="access_attendance_day" model="ir.access"><field name="name">Attendance day read</field><field name="model_id" ref="model_hrm_attendance_day"/><field name="group_id" ref="hrm_base.group_hrm_user"/><field name="operation">r</field></record>
<record id="scope_attendance_day" model="ir.access"><field name="name">Attendance day company privacy</field><field name="model_id" ref="model_hrm_attendance_day"/><field name="operation">crud</field><field name="domain">[('company_id', 'in', user.hrm_company_ids.ids)]</field></record>
<record id="attendance_month_search" model="ir.ui.view"><field name="name">hrm.attendance.month.search</field><field name="model">hrm.attendance.month</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="employee_code"/><field name="period_id"/><filter name="has_source" string="Attendance recorded" domain="[('source_count', '&gt;', 0)]"/><filter name="missing_source" string="No attendance data" domain="[('source_count', '=', 0)]"/><filter name="group_period" string="By period" context="{'group_by': 'period_id'}"/><filter name="group_employee" string="By employee" context="{'group_by': 'employee_id'}"/><searchpanel><field name="company_id" enable_counters="1"/><field name="year" enable_counters="1"/><field name="month" enable_counters="1"/></searchpanel></search></field></record>
<record id="attendance_month_list" model="ir.ui.view"><field name="name">hrm.attendance.month.list</field><field name="model">hrm.attendance.month</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" default_order="period_start desc, employee_code" decoration-muted="employment_status in ('terminated','alumni')" decoration-warning="source_count == 0"><field name="company_id" optional="hide"/><field name="period_label" width="85px"/><field name="year" optional="hide"/><field name="month" optional="hide"/><field name="period_id" optional="hide"/><field name="employee_code" width="100px"/><field name="employee_id" width="220px"/><field name="assignment_department" optional="show"/><field name="assignment_projects" optional="show"/><field name="standard_days" optional="hide"/><field name="total_days" sum="Total paid days"/><field name="total_hours" sum="Total hours"/><field name="overtime_hours" sum="Giờ tăng ca"/><field name="data_state"/><field name="recorded_days" optional="hide"/><field name="source_count" optional="hide"/><field name="employment_status" column_invisible="True"/>
<button name="action_details" type="object" string="Attendance details"/><button name="action_monthly_workspace" type="object" string="Attendance and payroll" groups="hrm_data_import.group_import_operator"/>
<field name="d01"/><field name="d02"/><field name="d03"/><field name="d04"/><field name="d05"/><field name="d06"/><field name="d07"/><field name="d08"/><field name="d09"/><field name="d10"/><field name="d11"/><field name="d12"/><field name="d13"/><field name="d14"/><field name="d15"/><field name="d16"/><field name="d17"/><field name="d18"/><field name="d19"/><field name="d20"/><field name="d21"/><field name="d22"/><field name="d23"/><field name="d24"/><field name="d25"/><field name="d26"/><field name="d27"/><field name="d28"/><field name="d29"/><field name="d30"/><field name="d31"/>
</list></field></record>
<record id="attendance_month_pivot" model="ir.ui.view"><field name="name">hrm.attendance.month.pivot</field><field name="model">hrm.attendance.month</field><field name="arch" type="xml"><pivot string="Monthly attendance summary"><field name="year" type="row"/><field name="month" type="row"/><field name="employee_id" type="row"/><field name="total_hours" type="measure"/><field name="total_days" type="measure"/></pivot></field></record>
<record id="attendance_day_list" model="ir.ui.view"><field name="name">hrm.attendance.day.list</field><field name="model">hrm.attendance.day</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="work_date"/><field name="employee_code"/><field name="employee_id"/><field name="attendance_symbol"/><field name="hours" sum="Total hours"/><field name="overtime_hours" sum="Giờ tăng ca"/><field name="project_code"/><field name="source"/><field name="revision"/><field name="approval_reference"/><field name="batch_id"/></list></field></record>
<record id="attendance_day_search" model="ir.ui.view"><field name="name">hrm.attendance.day.search</field><field name="model">hrm.attendance.day</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="work_date"/><field name="period_id"/><filter name="group_date" string="By day" context="{'group_by': 'work_date:day'}"/><filter name="group_employee" string="By employee" context="{'group_by': 'employee_id'}"/></search></field></record>
<record id="attendance_day_pivot" model="ir.ui.view"><field name="name">hrm.attendance.day.pivot</field><field name="model">hrm.attendance.day</field><field name="arch" type="xml"><pivot string="Daily attendance"><field name="employee_id" type="row"/><field name="work_date" type="col" interval="day"/><field name="hours" type="measure"/></pivot></field></record>
<record id="hrm_time.action_hrm_timesheet" model="ir.actions.act_window"><field name="name">Monthly attendance and history</field><field name="res_model">hrm.attendance.month</field><field name="view_mode">list,pivot</field><field name="view_id" ref="attendance_month_list"/><field name="search_view_id" ref="attendance_month_search"/><field name="context">{}</field><field name="help" type="html"><p>Select year/month on the left to see all employee attendance. Columns 01–31 show daily hours. Blank means no source; 0 means recorded zero hours; — means the day does not exist. Values come directly from saved Excel/web inputs.</p></field></record>
<record id="hrm_time.menu_hrm_timesheet" model="ir.ui.menu"><field name="name">All employee attendance</field><field name="sequence">1</field></record>
<record id="monthly_timesheet_button" model="ir.ui.view"><field name="name">hrm.monthly.workspace.timesheet.button</field><field name="model">hrm.monthly.workspace</field><field name="inherit_id" ref="monthly_workspace_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_timesheet" type="object" string="Attendance grid, days 01–31"/></xpath></field></record>
</odoo>
