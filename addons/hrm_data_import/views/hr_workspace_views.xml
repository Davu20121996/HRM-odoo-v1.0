<odoo>
<record id="employee_import_list" model="ir.ui.view"><field name="name">hrm.employee.import.list</field><field name="model">hrm.employee.import</field><field name="arch" type="xml"><list><field name="filename"/><field name="company_id"/><field name="state"/><field name="result"/></list></field></record>
<record id="employee_import_form" model="ir.ui.view"><field name="name">hrm.employee.import.form</field><field name="model">hrm.employee.import</field><field name="arch" type="xml"><form><header><button name="action_preview" type="object" string="1. Check file" invisible="state != 'draft'"/><button name="action_import" type="object" string="2. Import employees" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet>
<p>Import employee.xlsx, worksheet VP. Required columns: code, full_name and working_status_id (source values: Đang làm việc / Nghỉ việc). Birth date, national ID, contact and bank fields are supported; blank cells keep current values. Source tax/insurance columns need verification and are not automatically imported. Updating a profile does not change employment status.</p>
<group><field name="company_id" readonly="state != 'draft'"/><field name="tenant_id"/><field name="filename" readonly="state != 'draft'"/><field name="file_data" filename="filename" readonly="state != 'draft'"/><field name="sheet" readonly="state != 'draft'"/><field name="update_existing" readonly="state != 'draft'"/><field name="result"/></group><notebook><page string="Column mapping"><p>Source column names are on the left; employee fields are on the right. Adapt names to the company file and remove unused mappings.</p><field name="mapping_ids" readonly="state != 'draft'"><list editable="bottom"><field name="source"/><field name="target"/></list></field></page><page string="Preview employee records"><field name="preview"/></page></notebook></sheet></form></field></record>
<record id="action_employee_import" model="ir.actions.act_window"><field name="name">Import employee records</field><field name="res_model">hrm.employee.import</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_employee_import" name="Import employees" parent="menu_root" action="action_employee_import" sequence="2"/>
<record id="employee_details_form" model="ir.ui.view"><field name="name">hr.employee.hrm.details</field><field name="model">hr.employee</field><field name="inherit_id" ref="hrm_employee.view_hr_employee_form_hrm"/><field name="arch" type="xml"><xpath expr="//page[@name='hrm']" position="inside">
<group string="Employee source profile" groups="hrm_data_import.group_import_operator"><group><field name="hrm_birth_date"/><field name="hrm_identity_number"/><field name="hrm_identity_date"/><field name="hrm_identity_place"/></group><group><field name="work_phone"/><field name="mobile_phone"/><field name="work_email"/><field name="hrm_bank_number"/><field name="hrm_bank_name"/><field name="hrm_bank_branch"/></group></group>

<group string="Employment contracts and addenda" groups="hrm_data_import.group_import_operator"><field name="hrm_contract_ids" context="{'default_employee_id': id, 'default_tenant_id': tenant_id, 'default_company_id': hrm_company_id}"><list><field name="contract_no"/><field name="parent_id"/><field name="start_date"/><field name="end_date"/><field name="base_salary" digits="[19,0]"/><field name="status"/></list></field></group>
<group string="All populated original source fields" groups="hrm_data_import.group_import_operator"><field name="hrm_source_table" nolabel="1"/></group>
</xpath></field></record>
<record id="period_workspace_form" model="ir.ui.view"><field name="name">hrm.payroll.period.workspace</field><field name="model">hrm.payroll.period</field><field name="inherit_id" ref="view_period_input_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="before"><header>
<button name="action_import_attendance" type="object" string="1. Enter attendance"/><button name="action_import_performance" type="object" string="2. Enter performance"/>
<button name="action_check_ready" type="object" string="3. Check data"/><button name="action_quick_payroll" type="object" string="4. Calculate monthly payroll" class="oe_highlight" invisible="status not in ('open', 'processing')"/>
<button name="action_reopen_inputs" type="object" string="Reopen for correction and recalculation" groups="hrm_data_import.group_import_approver" invisible="status in ('approved', 'finalized', 'paid')"/>
</header></xpath><xpath expr="//sheet" position="inside">
<p>Select the period and confirmed standard days. Import attendance/performance using approved column mappings → Check data → Calculate monthly payroll. Reopen an unfinalized period with a reason before importing a higher revision. Previous results are logged and must be recalculated. Approved/finalized payroll cannot be reopened.</p>
<group><field name="selected_employee_ids" widget="many2many_tags"/><field name="readiness"/><field name="correction_reason"/></group><field name="payroll_ids" readonly="1"><list><field name="run_no"/><field name="calculation_version"/><field name="status"/></list></field>
</xpath></field></record>
<record id="action_monthly_workspace" model="ir.actions.act_window"><field name="name">Monthly payroll processing</field><field name="res_model">hrm.payroll.period</field><field name="view_id" ref="view_period_input_form"/><field name="view_mode">form,list</field></record>
<menuitem id="menu_monthly_workspace" name="Monthly payroll processing" parent="menu_root" action="action_period_input" sequence="3"/>
</odoo>