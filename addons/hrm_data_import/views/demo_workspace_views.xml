<odoo>
  <record id="view_demo_employee_list" model="ir.ui.view"><field name="name">hr.employee.demo.source.list</field><field name="model">hr.employee</field><field name="priority">90</field><field name="arch" type="xml"><list decoration-muted="current_status == 'terminated'"><field name="employee_code"/><field name="name"/><field name="hrm_company_id"/><field name="current_status"/><field name="active"/></list></field></record>
  <record id="view_demo_workspace_list" model="ir.ui.view"><field name="name">hrm.demo.workspace.list</field><field name="model">hrm.demo.workspace</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="name"/><field name="company_id"/><field name="employee_count"/><field name="working_count"/><field name="departed_count"/></list></field></record>
  <record id="view_demo_workspace_form" model="ir.ui.view"><field name="name">hrm.demo.workspace.form</field><field name="model">hrm.demo.workspace</field><field name="arch" type="xml">
    <form create="0" edit="0" delete="0"><header>
      <button name="action_employees" type="object" string="View employees" class="oe_highlight"/>
      <button name="action_profiles" type="object" string="Source file mappings"/>
      <button name="action_logs" type="object" string="Xem log"/>
    </header><sheet><div class="oe_title"><h1><field name="name"/></h1></div>
      <group><group><field name="company_id"/><field name="prepared_on"/></group><group><field name="employee_count"/><field name="working_count"/><field name="departed_count"/></group></group>
      <separator string="Business workflow with source data"/>
      <p>Employee records have been imported from the source. Attendance and performance require populated files before payroll calculation, reconciliation and approval. Do not invent payroll amounts or treat missing submissions as zero.</p>
      <field name="notes" nolabel="1"/>
      <separator string="Company source files"/>
      <field name="source_ids"><list create="0" edit="0" delete="0"><field name="filename"/><field name="sheets"/><field name="record_count"/><field name="state"/><button name="action_download" type="object" string="Download original file" icon="fa-download"/></list></field>
    </sheet></form>
  </field></record>
  <record id="view_demo_source_form" model="ir.ui.view"><field name="name">hrm.demo.source.form</field><field name="model">hrm.demo.source</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><header><button name="action_download" type="object" string="Download original file"/></header><sheet><group><field name="filename"/><field name="company_id"/><field name="sheets"/><field name="record_count"/><field name="state"/><field name="sha256"/><field name="profile_id"/></group><field name="details" nolabel="1"/></sheet></form></field></record>
  <record id="action_demo_workspace" model="ir.actions.act_window"><field name="name">Demo company from source files</field><field name="res_model">hrm.demo.workspace</field><field name="view_mode">list,form</field></record>
  <menuitem id="menu_demo_workspace" name="Demo company" parent="hrm_base.menu_hrm_root" action="action_demo_workspace" sequence="1" groups="group_import_operator"/>
</odoo>