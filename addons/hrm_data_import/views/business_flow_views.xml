<odoo>
<menuitem id="menu_company_start" name="Company information" parent="hrm_base.menu_hrm_root" action="hrm_base.action_hrm_company" groups="group_import_operator" sequence="0"/>
<record id="contract_details_form" model="ir.ui.view"><field name="name">hrm.employee.contract.details</field><field name="model">hrm.employee.contract</field><field name="inherit_id" ref="hrm_employee.view_hrm_employee_contract_form"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside">
<group string="Contract salary"><field name="structure_id"/><field name="parent_id" domain="[('employee_id', '=', employee_id), ('company_id', '=', company_id), ('parent_id', '=', False)]"/><field name="changes_salary" invisible="not parent_id"/><field name="working_hours_per_week"/><field name="signed_at"/></group>
<notebook><page string="Employee information from Excel"><group groups="hrm_data_import.group_import_operator"><field name="employee_birth_date"/><field name="employee_identity"/></group></page><page string="Terms"><field name="terms"/><group><field name="job_description"/><field name="workplace"/></group></page><page string="Addenda"><field name="appendix_ids" context="{'default_parent_id': id, 'default_currency_code': currency_code, 'default_structure_id': structure_id, 'default_base_salary': base_salary, 'default_contract_type_id': contract_type_id, 'default_employee_id': employee_id, 'default_company_id': company_id, 'default_tenant_id': tenant_id}"><list><field name="contract_no"/><field name="start_date"/><field name="end_date"/><field name="changes_salary"/><field name="base_salary" digits="[19,0]"/><field name="status"/></list></field></page><page string="Signed document"><group><field name="attachment_filename"/><field name="signed_document" filename="attachment_filename"/></group></page></notebook>
</xpath></field></record>
<record id="manual_input_list" model="ir.ui.view"><field name="name">hrm.manual.input.list</field><field name="model">hrm.manual.input</field><field name="arch" type="xml"><list><field name="period_id"/><field name="employee_id"/><field name="dataset"/><field name="work_date"/><field name="regular_hours"/><field name="component_id"/><field name="amount"/><field name="revision"/><field name="batch_id"/></list></field></record>
<record id="manual_input_form" model="ir.ui.view"><field name="name">hrm.manual.input.form</field><field name="model">hrm.manual.input</field><field name="arch" type="xml"><form><header><button name="action_publish" type="object" string="Validate and save" class="oe_highlight" invisible="batch_id"/></header><sheet><p>Enter attendance or performance per employee. The source ID identifies one record. Correct it with a new entry using the same ID and a higher revision. All entries are logged and validated like Excel imports. Do not overwrite another source.</p><group readonly="batch_id"><field name="company_id"/><field name="tenant_id"/><field name="period_id"/><field name="employee_id"/><field name="dataset"/><field name="work_date" invisible="dataset != 'attendance'"/><field name="regular_hours" invisible="dataset != 'attendance'"/><field name="component_id" invisible="dataset == 'attendance'"/><field name="amount" invisible="dataset == 'attendance'"/><field name="source_record_id"/><field name="revision"/><field name="approval_reference"/></group><group><field name="batch_id"/></group></sheet></form></field></record>
<record id="manual_input_search" model="ir.ui.view"><field name="name">hrm.manual.input.search</field><field name="model">hrm.manual.input</field><field name="arch" type="xml"><search><field name="period_id"/><field name="employee_id"/><field name="dataset"/><filter name="month" string="Month" context="{'group_by': 'period_id'}"/><filter name="employee" string="Employees" context="{'group_by': 'employee_id'}"/></search></field></record>
<record id="action_manual_input" model="ir.actions.act_window"><field name="name">Manual attendance and performance</field><field name="res_model">hrm.manual.input</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_manual_input" name="Manual attendance and performance" parent="menu_root" action="action_manual_input" sequence="4"/>
<record id="input_search_month" model="ir.ui.view"><field name="name">hrm.import.input.search.month</field><field name="model">hrm.import.input</field><field name="arch" type="xml"><search><field name="period_id"/><field name="employee_id"/><field name="dataset"/><field name="company_id"/><filter name="month" string="By month" context="{'group_by': 'period_id'}"/><filter name="by_employee" string="By employee" context="{'group_by': 'employee_id'}"/><filter name="attendance" string="Attendance" domain="[('dataset', '=', 'attendance')]"/><filter name="performance" string="Performance" domain="[('dataset', '=', 'performance')]"/></search></field></record>
<record id="payroll_item_details" model="ir.ui.view"><field name="name">hrm.payroll.item.details</field><field name="model">hrm.payroll.item</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="payroll_id"/><field name="employee_id"/><field name="currency_code"/><field name="status"/></group><group string="Payslip preview"><field name="gross_amount"/><field name="deduction_amount"/><field name="tax_amount"/><field name="net_amount"/></group><field name="detail_ids"><list create="0" edit="0" delete="0"><field name="code"/><field name="name"/><field name="amount"/><field name="currency_code"/></list></field><p>This is a calculated result for reconciliation. Official payslips are issued after payroll approval and finalization.</p></sheet></form></field></record>
<record id="payroll_item_report_list" model="ir.ui.view"><field name="name">hrm.payroll.item.report.list</field><field name="model">hrm.payroll.item</field><field name="arch" type="xml"><list create="0" edit="0" delete="0"><field name="period_id"/><field name="company_id"/><field name="payroll_id"/><field name="employee_id"/><field name="gross_amount" sum="Total gross pay"/><field name="deduction_amount" sum="Total deductions"/><field name="tax_amount" sum="Total tax"/><field name="net_amount" sum="Total net pay"/><field name="currency_code"/><field name="status"/></list></field></record>
<record id="payroll_item_pivot" model="ir.ui.view"><field name="name">hrm.payroll.item.pivot</field><field name="model">hrm.payroll.item</field><field name="arch" type="xml"><pivot string="Payroll report"><field name="period_id" type="row"/><field name="company_id" type="row"/><field name="employee_id" type="row"/><field name="currency_code" type="col"/><field name="gross_amount" type="measure"/><field name="deduction_amount" type="measure"/><field name="tax_amount" type="measure"/><field name="net_amount" type="measure"/></pivot></field></record>
<record id="payroll_item_report_search" model="ir.ui.view"><field name="name">hrm.payroll.item.report.search</field><field name="model">hrm.payroll.item</field><field name="arch" type="xml"><search><field name="period_id"/><field name="company_id"/><field name="employee_id"/><field name="payroll_id"/><filter name="final" string="Finalized" domain="[('status', 'in', ['finalized', 'paid'])]"/><filter name="run" string="By payroll run" context="{'group_by': 'payroll_id'}"/></search></field></record>
<record id="action_payroll_report" model="ir.actions.act_window"><field name="name">Payroll reports and payslips</field><field name="res_model">hrm.payroll.item</field><field name="view_mode">list,pivot,form</field><field name="view_id" ref="payroll_item_report_list"/></record>
<menuitem id="menu_payroll_report" name="Payroll reports and payslips" parent="menu_root" action="action_payroll_report" sequence="5"/>
<menuitem id="menu_company_setup" name="Company information" parent="menu_root" action="hrm_base.action_hrm_company" sequence="0"/>
<menuitem id="menu_employee_records" name="Employee records" parent="menu_root" action="hrm_employee.action_hr_employee_hrm" sequence="2"/>
<menuitem id="menu_contract_records" name="Contracts and addenda" parent="menu_root" action="hrm_employee.action_hrm_employee_contract" sequence="3"/>
</odoo>