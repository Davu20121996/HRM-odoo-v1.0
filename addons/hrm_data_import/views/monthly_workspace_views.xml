<odoo>
<record id="access_monthly_workspace" model="ir.access"><field name="name">Monthly workspace operator</field><field name="model_id" ref="model_hrm_monthly_workspace"/><field name="group_id" ref="group_import_operator"/><field name="operation">crud</field></record>
<record id="scope_monthly_workspace" model="ir.access"><field name="name">Monthly workspace company</field><field name="model_id" ref="model_hrm_monthly_workspace"/><field name="operation">crud</field><field name="domain">[('company_id', 'in', user.hrm_company_ids.ids)]</field></record>
<record id="access_monthly_line" model="ir.access"><field name="name">Monthly line read</field><field name="model_id" ref="model_hrm_monthly_line"/><field name="group_id" ref="group_import_operator"/><field name="operation">r</field></record>
<record id="scope_monthly_line" model="ir.access"><field name="name">Monthly line company</field><field name="model_id" ref="model_hrm_monthly_line"/><field name="operation">crud</field><field name="domain">[('company_id', 'in', user.hrm_company_ids.ids)]</field></record>
<record id="monthly_workspace_form" model="ir.ui.view"><field name="name">hrm.monthly.workspace.form</field><field name="model">hrm.monthly.workspace</field><field name="arch" type="xml"><form><header><button name="action_refresh" type="object" string="Refresh monthly data" class="oe_highlight"/><button name="action_all_employees" type="object" string="All employees"/><button name="action_period" type="object" string="Set up payroll period"/><button name="action_import_attendance" type="object" string="Import attendance Excel"/><button name="action_import_performance" type="object" string="Import performance Excel"/><button name="action_manual" type="object" string="Manual entry / attendance"/><button name="action_calculate" type="object" string="Quick payroll calculation"/></header><sheet><div class="oe_title"><h1>Attendance • Performance • Payroll</h1></div><group><group><field name="company_id"/><field name="year" options="{'enable_formatting': False}"/><field name="month"/></group><group><field name="employee_id"/><field name="period_id"/></group></group><field name="notice" nolabel="1"/><field name="line_ids" nolabel="1"><list create="0" edit="0" delete="0" decoration-muted="state == 'Đã nghỉ — chỉ xem hồ sơ'"><field name="employee_code"/><field name="employee_id"/><field name="paid_days"/><field name="hours" optional="hide"/><field name="performance" sum="Total performance"/><field name="base_salary"/><field name="gross" sum="Total gross pay"/><field name="deduction" sum="Total deductions"/><field name="net" sum="Total net pay"/><field name="state"/><field name="result_id" column_invisible="True"/><button name="action_inputs" type="object" string="Attendance / performance" icon="fa-calendar"/><button name="action_salary" type="object" string="Payslip" icon="fa-file-text-o" invisible="not result_id"/></list></field></sheet></form></field></record>
<record id="monthly_workspace_list" model="ir.ui.view"><field name="name">hrm.monthly.workspace.list</field><field name="model">hrm.monthly.workspace</field><field name="arch" type="xml"><list><field name="company_id"/><field name="year" options="{'enable_formatting': False}"/><field name="month"/><field name="employee_id"/></list></field></record>
<record id="action_monthly_overview" model="ir.actions.act_window"><field name="name">Monthly attendance and payroll</field><field name="res_model">hrm.monthly.workspace</field><field name="view_mode">list,form</field></record>
<menuitem id="menu_monthly_overview" name="Monthly attendance and payroll" parent="hrm_base.menu_hrm_root" action="action_monthly_overview" groups="group_import_operator" sequence="1"/>
</odoo>