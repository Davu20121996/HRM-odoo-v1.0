<odoo>
<record id="report_contract" model="ir.actions.report"><field name="name">Print contract / addendum</field><field name="model">hrm.employee.contract</field><field name="report_type">qweb-pdf</field><field name="report_name">hrm_data_import.contract_document</field><field name="binding_model_id" ref="hrm_employee.model_hrm_employee_contract"/><field name="binding_type">report</field></record>
<template id="contract_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.basic_layout"><div class="page">
<h3 t-field="doc.company_id.name"/><h2><t t-if="doc.parent_id">CONTRACT ADDENDUM</t><t t-else="">EMPLOYMENT CONTRACT</t></h2><p>Number: <span t-field="doc.contract_no"/> — Status: <span t-field="doc.status"/></p><p t-if="doc.parent_id">Parent contract: <span t-field="doc.parent_id.contract_no"/></p><p>Employee: <strong t-field="doc.employee_id.name"/> — Code: <span t-field="doc.employee_id.employee_code"/></p><p>Effective from <span t-field="doc.start_date"/> to <span t-field="doc.end_date"/></p><p>Base salary: <span t-field="doc.base_salary" t-options="{'widget': 'float', 'precision': 0}"/> <span t-field="doc.currency_code"/></p><p>Duties: <span t-field="doc.job_description"/></p><p>Workplace: <span t-field="doc.workplace"/></p><div t-field="doc.terms"/><p style="margin-top:40px">Company representative                 Employee</p>
</div></t></t></t></template>
<record id="report_salary_preview" model="ir.actions.report"><field name="name">Print payroll reconciliation</field><field name="model">hrm.payroll.item</field><field name="report_type">qweb-pdf</field><field name="report_name">hrm_data_import.salary_preview</field><field name="binding_model_id" ref="hrm_payroll.model_hrm_payroll_item"/><field name="binding_type">report</field></record>
<template id="salary_preview"><t t-call="web.html_container"><t t-foreach="docs" t-as="doc"><t t-call="web.basic_layout"><div class="page"><h3 t-field="doc.payroll_id.company_id.name"/><h2>PAYROLL RECONCILIATION</h2><p>Period <span t-field="doc.payroll_id.period_id.period_code"/> — Calculation <span t-field="doc.payroll_id.calculation_version"/> — Status <span t-field="doc.payroll_id.status"/></p><p>Employee: <strong t-field="doc.employee_id.name"/> (<span t-field="doc.employee_id.employee_code"/>)</p><table class="table"><thead><tr><th>Salary component</th><th>Amount</th></tr></thead><tbody><tr t-foreach="doc.detail_ids" t-as="line"><td t-field="line.name"/><td><span t-field="line.amount"/> <span t-field="line.currency_code"/></td></tr></tbody></table><p>Gross pay: <span t-field="doc.gross_amount"/>; Khấu trừ: <span t-field="doc.deduction_amount"/>; Thuế: <span t-field="doc.tax_amount"/></p><h4>Net pay: <span t-field="doc.net_amount"/> <span t-field="doc.currency_code"/></h4><p t-if="doc.payroll_id.status not in ('finalized', 'paid')">Unfinalized — for reconciliation.</p></div></t></t></t></template>
</odoo>