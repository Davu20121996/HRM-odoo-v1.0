<odoo>
<record id="access_salary_adjustment" model="ir.access"><field name="name">Salary adjustment operator</field><field name="model_id" ref="model_hrm_salary_adjustment"/><field name="group_id" ref="group_import_operator"/><field name="operation">crud</field></record>
<record id="scope_salary_adjustment" model="ir.access"><field name="name">Salary adjustment company</field><field name="model_id" ref="model_hrm_salary_adjustment"/><field name="operation">crud</field><field name="domain">[('company_id','in',user.hrm_company_ids.ids)]</field></record>
<record id="salary_adjustment_form" model="ir.ui.view"><field name="name">hrm.salary.adjustment.form</field><field name="model">hrm.salary.adjustment</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve adjustment" class="oe_highlight" groups="hrm_data_import.group_import_approver" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><p>The amount REPLACES one component for one employee/month; it is not added to the old amount. Create a new adjustment for later corrections. The latest approved adjustment is used on recalculation. Lasting base salary changes require a contract addendum.</p><p>For calculated payroll: open the period, enter a reason, reopen for correction, approve the adjustment and recalculate. Approved/finalized periods are locked.</p><group readonly="state == 'approved'"><field name="company_id"/><field name="period_id"/><field name="employee_id"/><field name="component_id"/><field name="amount"/><field name="reason"/></group><group><field name="approved_by"/><field name="create_date"/><field name="create_uid"/></group></sheet></form></field></record>
<record id="salary_adjustment_list" model="ir.ui.view"><field name="name">hrm.salary.adjustment.list</field><field name="model">hrm.salary.adjustment</field><field name="arch" type="xml"><list><field name="company_id"/><field name="period_id"/><field name="employee_id"/><field name="component_id"/><field name="amount"/><field name="reason"/><field name="state"/><field name="approved_by"/></list></field></record>
<record id="action_salary_adjustment" model="ir.actions.act_window"><field name="name">Salary adjustments and history</field><field name="res_model">hrm.salary.adjustment</field><field name="view_mode">list,form</field></record>
<record id="salary_excel_search" model="ir.ui.view"><field name="name">hrm.payroll.item.excel.search</field><field name="model">hrm.payroll.item</field><field name="arch" type="xml"><search><field name="employee_id"/><field name="period_id"/><field name="payroll_id"/><searchpanel><field name="company_id" enable_counters="1"/><field name="salary_year" enable_counters="1"/><field name="salary_month" enable_counters="1"/></searchpanel></search></field></record>
<record id="salary_excel_list" model="ir.ui.view"><field name="name">hrm.payroll.item.excel.list</field><field name="model">hrm.payroll.item</field><field name="arch" type="xml"><list create="0" edit="0" delete="0" default_order="period_id desc, employee_id"><header><button name="action_export_salary_month" type="object" string="Export selected month to Excel"/></header><field name="salary_period" width="85px"/><field name="insurance_state" optional="show" width="130px"/><field name="employee_insurance" digits="[19,0]" width="130px"/><field name="net_amount" string="Net pay" sum="Total net pay" width="140px" digits="[19,0]"/><button name="action_salary_slip" type="object" title="Payslip / adjustment / formulas" icon="fa-file-text-o"/><field name="xl_a" width="110px"/><field name="xl_b" width="55px"/><field name="xl_c" width="220px"/><field name="xl_d" width="160px"/><field name="xl_e" width="160px"/><field name="assignment_projects" optional="show" width="160px"/><field name="xl_f" width="160px"/><field name="xl_g" width="160px"/><field name="xl_h" width="160px"/><field name="xl_i" width="160px"/><field name="xl_j" width="160px"/><field name="xl_k" width="160px"/><field name="xl_l" width="160px"/><field name="xl_m" width="160px"/><field name="xl_n" width="160px"/><field name="xl_o" width="160px"/><field name="xl_p" width="160px"/><field name="xl_q" width="160px"/><field name="xl_r" width="160px"/><field name="xl_s" width="160px"/><field name="xl_t" width="160px"/><field name="xl_u" width="160px"/><field name="xl_v" width="160px"/><field name="xl_w" width="160px"/><field name="xl_x" width="160px"/><field name="xl_y" width="160px"/><field name="xl_z" width="160px"/><field name="xl_aa" width="160px"/><field name="xl_ab" width="160px"/><field name="xl_ac" width="160px"/><field name="xl_ad" width="160px"/><field name="xl_ae" width="160px"/><field name="xl_af" width="160px"/><field name="xl_ag" width="160px"/><field name="xl_ah" width="160px"/><field name="xl_ai" width="160px"/><field name="xl_aj" width="160px"/><field name="xl_ak" width="160px"/><field name="xl_al" width="160px"/><field name="xl_am" width="160px"/><field name="xl_an" width="160px"/><field name="xl_ao" width="160px"/><field name="xl_ap" width="160px"/><field name="xl_aq" width="160px"/><field name="xl_ar" width="160px"/><field name="xl_as" width="160px"/><field name="xl_at" width="160px"/><field name="xl_au" width="160px"/><field name="xl_av" width="160px"/><field name="xl_aw" width="160px"/><field name="xl_ax" width="160px"/><field name="xl_ay" width="160px"/><field name="xl_az" width="160px"/><field name="status" optional="hide"/><field name="company_id" optional="hide"/></list></field></record>
<record id="action_salary_excel" model="ir.actions.act_window"><field name="name">Monthly Excel-style payroll</field><field name="res_model">hrm.payroll.item</field><field name="view_mode">list</field><field name="view_id" ref="salary_excel_list"/><field name="search_view_id" ref="salary_excel_search"/></record>
<menuitem id="menu_salary_excel" name="Excel-style payroll" parent="hrm_base.menu_hrm_root" action="action_salary_excel" groups="group_import_operator" sequence="2"/>
<menuitem id="menu_salary_adjustment" name="Salary adjustments and history" parent="menu_root" action="action_salary_adjustment" sequence="6"/>
<record id="monthly_salary_buttons" model="ir.ui.view"><field name="name">hrm.monthly.workspace.salary.buttons</field><field name="model">hrm.monthly.workspace</field><field name="inherit_id" ref="monthly_workspace_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_salary_grid" type="object" string="Excel-style payroll"/><button name="action_export_salary" type="object" string="Export payroll Excel"/></xpath></field></record>
<record id="formula_excel_editor" model="ir.ui.view"><field name="name">hrm.payroll.formula.excel.editor</field><field name="model">hrm.payroll.formula</field><field name="inherit_id" ref="view_formula_form"/><field name="arch" type="xml"><xpath expr="//header" position="inside"><button name="action_new_version" type="object" string="Create new version" invisible="state != 'approved'"/></xpath><xpath expr="//field[@name='expression']" position="before"><field name="excel_expression" readonly="state == 'approved'"/></xpath><xpath expr="//sheet" position="inside"><p>Same-row Excel columns: G = contract salary, M = performance, N = standard days, Q/U = paid days, V = calculated BASE component. Example: =ROUND(G12*U12/N12,0). Supports IF, IFERROR, SUM, MIN, MAX, ROUND, AND, OR and earlier component codes. VLOOKUP, external workbook links and other employee rows are not supported. Imported calculated amounts override formulas; approved adjustments have the highest priority.</p></xpath></field></record>
<record id="salary_slip_actions" model="ir.ui.view"><field name="name">hrm.payroll.item.salary.actions</field><field name="model">hrm.payroll.item</field><field name="inherit_id" ref="payroll_item_details"/><field name="arch" type="xml"><xpath expr="//sheet" position="before"><header><button name="action_adjust_salary" type="object" string="Adjust salary"/><button name="action_salary_formulas" type="object" string="Excel formulas"/><button name="action_salary_period" type="object" string="Open period / recalculate"/><button name="action_export_salary_month" type="object" string="Export entire month to Excel"/></header></xpath></field></record><record id="insurance_slip_details" model="ir.ui.view"><field name="name">hrm.payroll.item.insurance.details</field><field name="model">hrm.payroll.item</field><field name="inherit_id" ref="payroll_item_details"/><field name="arch" type="xml"><xpath expr="//field[@name='detail_ids']" position="before"><group string="Compulsory insurance"><field name="employee_insurance"/><field name="employer_insurance"/><field name="insurance_snapshot"/></group><p>Net pay = gross pay − other deductions − employee insurance − personal income tax. Total deductions already include employee insurance. Employer insurance does not reduce employee net pay.</p></xpath></field></record>
<record id="insurance_contract_details" model="ir.ui.view"><field name="name">hrm.employee.contract.insurance</field><field name="model">hrm.employee.contract</field><field name="inherit_id" ref="contract_details_form"/><field name="arch" type="xml"><xpath expr="//field[@name='structure_id']" position="after"><field name="insurance_salary"/></xpath></field></record>
<record id="insurance_period_details" model="ir.ui.view"><field name="name">hrm.payroll.period.insurance</field><field name="model">hrm.payroll.period</field><field name="inherit_id" ref="view_period_input_form"/><field name="arch" type="xml"><xpath expr="//field[@name='standard_days']" position="after"><field name="insurance_regional_minimum"/></xpath></field></record>
</odoo>