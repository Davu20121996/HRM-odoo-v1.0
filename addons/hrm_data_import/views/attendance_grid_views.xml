<odoo>
  <record id="attendance_symbol_read" model="ir.access">
    <field name="name">Attendance symbol read</field>
    <field name="model_id" ref="model_hrm_attendance_symbol"/>
    <field name="group_id" ref="group_import_operator"/>
    <field name="operation">r</field>
  </record>
  <record id="attendance_symbol_manage" model="ir.access">
    <field name="name">Attendance symbol configuration</field>
    <field name="model_id" ref="model_hrm_attendance_symbol"/>
    <field name="group_id" ref="group_import_approver"/>
    <field name="operation">crud</field>
  </record>
  <record id="attendance_symbol_scope" model="ir.access">
    <field name="name">Attendance symbol company scope</field>
    <field name="model_id" ref="model_hrm_attendance_symbol"/>
    <field name="domain">[('company_id', 'in', user.hrm_company_ids.ids)]</field>
    <field name="operation">crud</field>
  </record>
  <record id="attendance_symbol_list" model="ir.ui.view">
    <field name="name">hrm.attendance.symbol.list</field>
    <field name="model">hrm.attendance.symbol</field>
    <field name="arch" type="xml">
      <list editable="bottom">
        <field name="company_id"/>
        <field name="code"/>
        <field name="regular_hours"/>
        <field name="overtime_hours"/>
        <field name="enabled"/>
      </list>
    </field>
  </record>
  <record id="action_attendance_symbols" model="ir.actions.act_window">
    <field name="name">Ký hiệu chấm công</field>
    <field name="res_model">hrm.attendance.symbol</field>
    <field name="view_mode">list</field>
    <field name="help" type="html"><p>Thêm ký hiệu mới hoặc nhập cùng mã để thay mặc định cho các lần nhập sau. Giờ đã lưu trong các ô cũ được giữ theo lần chấm.</p></field>
  </record>
  <record id="action_attendance_grid" model="ir.actions.client">
    <field name="name">Bảng nhập công theo tháng</field>
    <field name="tag">hrm_attendance_grid</field>
  </record>
  <menuitem id="menu_attendance_grid" name="Bảng nhập công theo tháng" parent="hrm_time.menu_hrm_time"
            action="action_attendance_grid" sequence="0" groups="group_import_operator"/>
  <menuitem id="menu_attendance_symbols" name="Ký hiệu chấm công" parent="hrm_time.menu_hrm_time"
            action="action_attendance_symbols" sequence="3" groups="group_import_approver"/>
</odoo>
