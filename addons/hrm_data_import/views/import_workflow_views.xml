<odoo>
<record id="period_workspace_list" model="ir.ui.view"><field name="name">hrm.payroll.period.workspace.list</field><field name="model">hrm.payroll.period</field><field name="arch" type="xml"><list><field name="company_id"/><field name="period_code"/><field name="period_start"/><field name="period_end"/><field name="standard_days"/><field name="status"/></list></field></record>
<record id="period_list_binding" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="period_workspace_list"/><field name="act_window_id" ref="action_period_input"/></record>
<record id="profile_source_options" model="ir.ui.view"><field name="name">hrm.import.profile.source.options</field><field name="model">hrm.import.profile</field><field name="inherit_id" ref="view_profile_form"/><field name="arch" type="xml"><field name="header_row" position="after"><field name="data_start_row"/><field name="cached_header"/><field name="batch_identity"/></field></field></record>
<record id="batch_source_options" model="ir.ui.view"><field name="name">hrm.import.batch.source.options</field><field name="model">hrm.import.batch</field><field name="inherit_id" ref="view_batch_form"/><field name="arch" type="xml"><field name="period_id" position="after"><field name="company_id"/><field name="source_revision" readonly="state == 'committed'"/><field name="approval_reference" readonly="state == 'committed'"/></field><field name="profile_id" position="attributes"><attribute name="domain">[('company_id', '=', company_id), ('dataset', 'in', context.get('hrm_dataset') and [context.get('hrm_dataset')] or ['attendance', 'performance', 'history'])]</attribute></field></field></record>
<record id="period_form_binding" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="view_period_input_form"/><field name="act_window_id" ref="action_period_input"/></record>
</odoo>
