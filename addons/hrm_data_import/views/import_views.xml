<record id="view_input_form" model="ir.ui.view"><field name="name">hrm.import.input.form</field><field name="model">hrm.import.input</field><field name="arch" type="xml"><form create="0" edit="0" delete="0"><sheet><group><field name="tenant_id"/><field name="company_id"/><field name="period_id"/><field name="employee_id"/><field name="dataset"/><field name="source"/><field name="source_record_id"/><field name="revision"/><field name="batch_id"/><field name="payload"/></group></sheet></form></field></record>
