<odoo>
<record id="hrm_employee.action_hr_employee_hrm" model="ir.actions.act_window"><field name="name">Employee records</field><field name="context">{'active_test': False}</field></record>
<record id="employee_complete_form" model="ir.ui.view"><field name="name">hr.employee.hrm.complete.form</field><field name="model">hr.employee</field><field name="priority">5</field><field name="arch" type="xml"><form string="Employee records"><header><button name="action_monthly_overview" type="object" string="View monthly attendance and payroll" class="oe_highlight" groups="hrm_data_import.group_import_operator"/><button name="action_onboard" type="object" string="Onboarding" invisible="current_status != 'hired'"/><button name="action_activate" type="object" string="Start employment" invisible="current_status != 'onboarding'"/><button name="action_suspend" type="object" string="Suspended" invisible="current_status != 'active'"/><button name="action_terminate" type="object" string="Terminated" invisible="current_status not in ('onboarding', 'active', 'suspended', 'termination_pending')"/></header><sheet><div class="oe_title"><label for="name" string="Full name"/><h1><field name="name" placeholder="Enter full name"/></h1></div><group><group><field name="hrm_company_id" string="Company" required="1"/><field name="tenant_id" string="Data workspace" required="1"/><field name="employee_code" string="Employee code" required="1"/><field name="current_status" string="Employment status" readonly="1"/><field name="active" string="Currently displayed"/></group><group><field name="hire_date" string="Hire date"/><field name="termination_date" string="Termination date"/><field name="status_reason" string="Reason for status change"/><field name="work_phone" string="Phone"/><field name="mobile_phone" string="Mobile"/><field name="work_email" string="Work email"/></group></group><notebook><page string="Personal information" groups="hrm_data_import.group_import_operator"><group><group><field name="hrm_birth_date"/><field name="hrm_identity_number"/><field name="hrm_identity_date"/><field name="hrm_identity_place"/></group><group><field name="hrm_bank_number"/><field name="hrm_bank_name"/><field name="hrm_bank_branch"/></group></group><separator string="Excel information for reconciliation"/><field name="hrm_source_table" nolabel="1"/></page><page string="Contracts and addenda"><p>Base salary comes from the active contract or salary addendum. Create a new contract/addendum to change approved terms.</p><field name="hrm_contract_ids" context="{'default_employee_id': id, 'default_tenant_id': tenant_id, 'default_company_id': hrm_company_id}"><list><field name="contract_no" string="Contract No"/><field name="parent_id"/><field name="start_date" string="From date"/><field name="end_date" string="To date"/><field name="base_salary" string="Base salary" digits="[19,0]"/><field name="changes_salary"/><field name="status" string="Status"/></list></field></page><page string="Notes"><field name="additional_note" nolabel="1"/></page></notebook></sheet><chatter/></form></field></record>
<record id="employee_complete_list" model="ir.ui.view"><field name="name">hr.employee.hrm.complete.list</field><field name="model">hr.employee</field><field name="arch" type="xml"><list decoration-muted="current_status == 'terminated'"><field name="employee_code" string="Employee code"/><field name="name" string="Full name"/><field name="hrm_company_id" string="Company"/><field name="current_status" string="Status"/><field name="hire_date" string="Hire date"/><field name="termination_date" string="Leave date" optional="hide"/><field name="work_phone" string="Phone" optional="hide"/></list></field></record>
<record id="employee_complete_list_binding" model="ir.actions.act_window.view"><field name="sequence">1</field><field name="view_mode">list</field><field name="view_id" ref="employee_complete_list"/><field name="act_window_id" ref="hrm_employee.action_hr_employee_hrm"/></record>
<record id="employee_complete_form_binding" model="ir.actions.act_window.view"><field name="sequence">2</field><field name="view_mode">form</field><field name="view_id" ref="employee_complete_form"/><field name="act_window_id" ref="hrm_employee.action_hr_employee_hrm"/></record>
</odoo>
